{
  "id": "remote-nodes",
  "name": "Remote Nodes",
  "version": "0.2.0",
  "visible": false,
  "author": "NASNET Community",
  "license": "AGPL-3.0",
  "website": "https://github.com/nasnet-community/nasnet-panel-linux",
  "category": "proxy",
  "tagline": "An Xray entry on this router and on your domestic nodes.",
  "description": "Runs an Xray entry on the router itself, and installs and manages up to 3 Linux nodes, with no separate panel. Up to 10 subscriptions get one link for the router and one per node, and their traffic leaves through the router's VPN. Needs a domestic link and a VPN.",
  "icon": "icon.svg",
  "architectures": ["arm64", "amd64"],
  "minRouterOS": "7.20",
  "container": {
    "image": "ghcr.io/nasnet-community/remote-nodes:0.2.0",
    "interface": {
      "name": "veth-remote-nodes",
      "address": ["192.168.50.16/24", "192.168.50.17/24", "192.168.50.18/24"],
      "gateway": "192.168.50.1"
    },
    "env": {
      "BASE_PATH": "/api/plugin/view/remote-nodes"
    },
    "mounts": [
      {
        "name": "remote-nodes-data",
        "src": "remote-nodes/data",
        "dst": "/data"
      }
    ],
    "ports": [
      {
        "protocol": "tcp",
        "containerPort": 8080,
        "hostPort": "{{settings.webPort}}",
        "description": "Web dashboard"
      }
    ],
    "memoryHigh": "96M",
    "memoryMax": "128M"
  },
  "routing": [
    {
      "address": "192.168.50.16",
      "via": "foreign"
    },
    {
      "address": "192.168.50.17",
      "via": "vpn"
    },
    {
      "address": "192.168.50.18",
      "via": "domestic"
    }
  ],
  "scripts": {
    "preInstall": "scripts/pre-install.rsc",
    "postInstall": "scripts/post-install.rsc",
    "preUninstall": "scripts/pre-uninstall.rsc",
    "postWizard": "scripts/pre-install.rsc"
  },
  "settingsSchema": "settings.json",
  "keepDataOnUninstall": true
}
