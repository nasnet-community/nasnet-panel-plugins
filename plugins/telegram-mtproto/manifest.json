{
  "id": "telegram-mtproto",
  "name": "Remote MTProto",
  "version": "1.1.0",
  "visible": true,
  "author": "NASNET Community",
  "license": "MIT",
  "website": "https://github.com/nasnet-community/mtproto-remote-plugin",
  "category": "proxy",
  "tagline": "Run MTProto proxy servers on your VPSes.",
  "description": "Install and manage Telegram MTProto proxy servers on remote Linux VPSes. Their upstream connections are carried through this router, which dials Telegram on their behalf.",
  "icon": "icon.svg",
  "architectures": ["arm", "arm64", "amd64"],
  "container": {
    "image": "ghcr.io/nasnet-community/mtproto-remote-plugin:main",
    "interface": {
      "name": "veth-mtproto",
      "address": "192.168.50.11/24",
      "gateway": "192.168.50.1"
    },
    "env": {
      "BASE_PATH": "/api/plugin/view/telegram-mtproto"
    },
    "mounts": [
      {
        "name": "mtproto-data",
        "src": "telegram-mtproto/data",
        "dst": "/data"
      }
    ],
    "ports": [
      {
        "protocol": "tcp",
        "containerPort": 8080,
        "hostPort": "{{settings.webPort}}",
        "description": "Web dashboard"
      }
    ]
  },
  "scripts": {
    "preInstall": "scripts/pre-install.rsc",
    "postInstall": "scripts/post-install.rsc",
    "preUninstall": "scripts/pre-uninstall.rsc"
  },
  "settingsSchema": "settings.json"
}
