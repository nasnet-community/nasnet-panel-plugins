{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "{{settings.protocol}}",
      "settings": {
        "clients": [{ "id": "{{settings.uuid}}" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "{{settings.network}}",
        "wsSettings": { "path": "{{settings.wsPath}}" }
      }
    }
  ],
  "outbounds": [{ "protocol": "freedom" }]
}
